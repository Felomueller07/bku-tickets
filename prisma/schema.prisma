generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seat {
  id              Int       @id @default(autoincrement())
  row             String
  number          Int
  status          String    @default("available")
  reservationType String?
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id])
  firstName       String?
  lastName        String?
  email           String?
  note            String?
  
  // Lock-System Felder
  sessionId       String?
  lockExpiry      DateTime?
  lockedBy        String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([row, number])
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  firstName          String?
  lastName           String?
  password           String
  role               String              @default("user")
  emailVerified      Boolean             @default(false)
  seats              Seat[]
  freeTickets        FreeTicket[]
  voucherCodes       VoucherCode[]       @relation("VoucherUser")
  verificationCodes  VerificationCode[]
}


model VoucherCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  used      Boolean   @default(false)
  usedBy    Int?
  user      User?     @relation("VoucherUser", fields: [usedBy], references: [id])
  usedAt    DateTime?
  expiresAt DateTime? // ⬅️ NEU HINZUFÜGEN!
  createdAt DateTime  @default(now())
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FreeTicket {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?
  usedBy    Int?
  user      User?    @relation(fields: [usedBy], references: [id])
}

